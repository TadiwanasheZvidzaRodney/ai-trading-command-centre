# Copy with `npm run deploy -- init`, then fill in .env.deploy.local.
# This template is safe to commit. Never commit the populated local file.

DEPLOY_ENV=production

# Vercel control plane
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Render control plane
RENDER_API_KEY=
RENDER_SERVICE_ID=

# Public web build setting
NEXT_PUBLIC_API_URL=

# Runtime settings from packages/config/src/env.ts
NODE_ENV=production
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=4000
# Render supplies PORT at runtime. Do not set it here.
API_URL=
WEB_URL=
MONGODB_URI=
MONGODB_DB=atc
AUTH_MODE=session
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
SESSION_SECRET=
SESSION_TTL_HOURS=168
DEFAULT_TIMEZONE=Africa/Harare
TRADING_MODE=research
LIVE_TRADING_ENABLED=false
MARKET_DATA_QUOTE_PROVIDER=swissquote
MARKET_DATA_CANDLE_PROVIDER=yahoo
MARKET_DATA_CACHE_QUOTE_SECONDS=15
MARKET_DATA_CACHE_CANDLE_SECONDS=300
MARKET_DATA_TWELVE_DATA_API_KEY=
MARKET_DATA_OANDA_API_TOKEN=
MARKET_DATA_OANDA_ACCOUNT_ID=
MARKET_DATA_OANDA_ENVIRONMENT=practice
NEWS_PROVIDER=rss
NEWS_RSS_FEEDS=https://www.fxstreet.com/rss/news,https://www.ecb.europa.eu/rss/press.html,https://www.federalreserve.gov/feeds/press_all.xml,https://www.bankofengland.co.uk/rss/news,https://feeds.bbci.co.uk/news/business/rss.xml
NEWS_POLL_MINUTES=15
CALENDAR_PROVIDER=forexfactory
CALENDAR_POLL_MINUTES=60
AI_PROVIDER=disabled
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=60000
ENABLE_SCHEDULER=true
QUOTE_REFRESH_SECONDS=20
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
PAPER_STARTING_BALANCE=10000
PAPER_RISK_PER_TRADE_PCT=1
PAPER_MAX_DAILY_LOSS_PCT=3
PAPER_MAX_OPEN_RISK_PCT=5
PAPER_MAX_POSITIONS=3
PAPER_MIN_RR=1.5