{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@atc/shared": ["packages/shared/src/index.ts"],
      "@atc/config": ["packages/config/src/index.ts"],
      "@atc/market-data": ["packages/market-data/src/index.ts"],
      "@atc/technical-analysis": ["packages/technical-analysis/src/index.ts"],
      "@atc/news": ["packages/news/src/index.ts"],
      "@atc/economic-calendar": ["packages/economic-calendar/src/index.ts"],
      "@atc/ai-copilot": ["packages/ai-copilot/src/index.ts"],
      "@atc/ai-engine": ["packages/ai-engine/src/index.ts"],
      "@atc/risk-engine": ["packages/risk-engine/src/index.ts"],
      "@atc/trading-domain": ["packages/trading-domain/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", "coverage"]
}
