# ---------------------------------------------------------------------------
# AI Trading Command Centre - environment template
# Copy to .env and fill in only what you need. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# Runtime
API_HOST=0.0.0.0
API_PORT=4000
# Render supplies PORT at runtime; leave it unset locally.
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# MongoDB (local Docker Compose by default)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=atc

# Authentication
# development: "disabled" is allowed and shows a warning in the UI.
# production:  "session" is required.
# Generate a hash safely with: npm run auth:hash -- --deploy-file
AUTH_MODE=disabled
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
# Must be at least 32 characters. Replace in any shared or deployed environment.
SESSION_SECRET=dev-only-change-this-session-secret-32chars
SESSION_TTL_HOURS=168

# User preferences
DEFAULT_TIMEZONE=Africa/Harare

# Trading safety
TRADING_MODE=research
LIVE_TRADING_ENABLED=false

# Market data
# Quotes: swissquote (free public feed, no key)
# Candles: yahoo (free public chart endpoint, no key; GC=F is used as a
# clearly-labelled proxy for XAU/USD history)
MARKET_DATA_QUOTE_PROVIDER=swissquote
MARKET_DATA_CANDLE_PROVIDER=yahoo
MARKET_DATA_CACHE_QUOTE_SECONDS=15
MARKET_DATA_CACHE_CANDLE_SECONDS=300
# Optional upgrade providers (leave blank until you have keys)
MARKET_DATA_TWELVE_DATA_API_KEY=
MARKET_DATA_OANDA_API_TOKEN=
MARKET_DATA_OANDA_ACCOUNT_ID=
MARKET_DATA_OANDA_ENVIRONMENT=practice

# News (RSS, no key). Comma-separated feed URLs.
NEWS_PROVIDER=rss
NEWS_RSS_FEEDS=https://www.fxstreet.com/rss/news,https://feeds.content.dowjones.io/public/rss/mw_topstories,https://www.ecb.europa.eu/rss/press.html,https://www.federalreserve.gov/feeds/press_all.xml,https://www.bankofengland.co.uk/rss/news,https://feeds.bbci.co.uk/news/business/rss.xml
NEWS_POLL_MINUTES=15

# Economic calendar (community JSON feed, no key)
CALENDAR_PROVIDER=forexfactory
CALENDAR_POLL_MINUTES=60

# AI analysis
# disabled | ollama | gemini | openai-compatible
# "disabled" still produces deterministic evidence reports, clearly labelled.
AI_PROVIDER=disabled
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=60000
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4000
AI_REQUEST_TIMEOUT_MS=15000

# Background jobs (quote refresh, news/calendar ingestion, paper-trade monitor)
ENABLE_SCHEDULER=true
QUOTE_REFRESH_SECONDS=20

# API protection
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# Paper trading defaults (USD account, USD-quoted instruments only for now)
PAPER_STARTING_BALANCE=10000
PAPER_RISK_PER_TRADE_PCT=1
PAPER_MAX_DAILY_LOSS_PCT=3
PAPER_MAX_OPEN_RISK_PCT=5
PAPER_MAX_POSITIONS=3
PAPER_MIN_RR=1.5
